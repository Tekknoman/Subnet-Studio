{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subnet Studio recursive network plan v2",
  "type": "object",
  "required": [
    "version",
    "name",
    "roots"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "name": {
      "type": "string"
    },
    "draft": {
      "type": "boolean"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "cidr",
        "status",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "cidr": {
          "type": "string"
        },
        "status": {
          "enum": [
            "container",
            "active",
            "reserved"
          ]
        },
        "requiredHosts": {
          "type": "integer",
          "minimum": 0
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
