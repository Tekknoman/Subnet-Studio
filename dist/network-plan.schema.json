{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subnet Studio IPv4 Plan v1",
  "type": "object",
  "required": [
    "version",
    "name",
    "pools"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "sourceNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "campus": {
      "type": "object",
      "required": [
        "name",
        "cidr",
        "poolIds"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "cidr": {
          "type": "string"
        },
        "poolIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cidr",
          "allocations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cidr": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "allocations": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "cidr",
                "location",
                "status",
                "requiredHosts"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "cidr": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "active",
                    "reserved"
                  ]
                },
                "requiredHosts": {
                  "type": "integer",
                  "minimum": 0
                },
                "growthPrefix": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                }
              }
            }
          }
        }
      }
    }
  }
}